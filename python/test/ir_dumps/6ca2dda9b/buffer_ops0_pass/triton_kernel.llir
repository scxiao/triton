  %46 = fcmp uno <4 x float> %45, zeroinitializer, !dbg !28
  %47 = shufflevector <2 x float> %39, <2 x float> %44, <4 x i32> <i32 0, i32 1, i32 2, i32 3>, !dbg !28
  %48 = bitcast <4 x float> %47 to <4 x i32>, !dbg !28
  %49 = add <4 x i32> %48, splat (i32 32767), !dbg !28
  %50 = shufflevector <2 x float> %39, <2 x float> %44, <4 x i32> <i32 0, i32 1, i32 2, i32 3>, !dbg !28
  %51 = bitcast <4 x float> %50 to <4 x i32>, !dbg !28
